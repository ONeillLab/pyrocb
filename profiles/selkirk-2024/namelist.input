! reduce hours to test tign
 &time_control
 run_days                            = 1,
 run_hours                           = 13,
 run_minutes                         = 0,
 run_seconds                         = 0,
 start_year                          = 2024, 2024, 2024,
 start_month                         = 07,   06,   06,
 start_day                           = 22,   22,   27,
 start_hour                          = 15,   15,   15,
 end_year                            = 2024, 2024, 2024,
 end_month                           = 07,   07,   06,
 end_day                             = 28,   28,   28,
 end_hour                            = 23,   23,   23,
 interval_seconds                    = 3600,
 input_from_file                     = .true., .true., .true.,
 history_interval                    = 60,   60,   20,
 ! how often wrf writes output to the wrfout files in mins
 history_outname = '/scratch/su386/pyrocb/out/output/selkirk-2024/history/wrfout_d<domain>_<date>'
 ! Set output locations
 frames_per_outfile                  = 1,    1,    1,	
 ! how many output timesteps go into each wrfout file
 restart                             = .false.,
 restart_interval                    = 720,
 ! how often wrf writes a restart file in mins
 io_form_history                     = 2,		
 ! format of wrfout output files as NetCDF
 io_form_restart                     = 2,		
 ! format of restart files
 io_form_input                       = 2,		
 ! format of input files
 io_form_boundary                    = 2,		
 ! format of wrfbdy files (boundary conditions)
 /

 &domains
 time_step                           = 3,
 time_step_fract_num                 = 0,		
 time_step_fract_den                 = 1,
 max_dom                             = 3,
 e_we                                = 300,  301,  301,
 e_sn                                = 300,  301,  301,
 e_vert                              = 50,   50,   50,	
 p_top_requested                     = 5000,		
 num_metgrid_levels                  = 38,		
 num_metgrid_soil_levels             = 4,		
 dx                                  = 1800, 600,  200,
 dy                                  = 1800, 600,  200,
 grid_id                             = 1,    2,    3,
 parent_id                           = 1,    1,    2,
 i_parent_start                      = 1,    100,  100,
 j_parent_start                      = 1,    100,  100,
 parent_grid_ratio                   = 1,    3,    3,
 parent_time_step_ratio              = 1,    3,    3,	
 feedback                            = 1,
 smooth_option                       = 0,		
 sr_x                                = 1,    1,    7,	
 sr_y                                = 1,    1,    7,	
 ! smooth_cg_topo			     = .true.,
 sfcp_to_sfcp                        = .true.,
  /

 &physics
 mp_physics                          = 8,    8,    8,	
 ! Microphysics
 ra_lw_physics                       = 4,    4,    4,	
 ! Longwave radiation
 ra_sw_physics                       = 4,    4,    4,	
 ! Shortwave radiation
 radt                                = 1,   1,   1,	
 ! Radiation time step
 sf_sfclay_physics                   = 1,    1,    1,	
 ! Surface layer physics option
 sf_surface_physics                  = 2,    2,    2,	
 ! Land surface option
 bl_pbl_physics                      = 1,    1,    0,	
 ! Boundary layer option. same value should be used for all domains except when running an LES sim. Turn off PBL for innermost domain
 bldt                                = 0,    0,    0,	
 ! Minutes between boundary layer physics calls (0 for every time step recommended)
 cu_physics                          = 0,    0,    0,	
 ! Cuxmulus parametericcation option
 cudt                                = 0,    0,    0,	
 ! minutes between cu_physics calls
 surface_input_source                = 3,
 ! Source for landuse and soil category
 num_land_cat                        = 21,		
 ! number of land categories from input data. 21 for MODIS if lake category is included which is default for WPS.
 icloud                              = 1,
 ! cloud effect to optical edpth in radiation
 sf_urban_physics                    = 0,    0,    0,
 ! Activate urban canopy model. Not needed in large forest regions
 /

 &fdda	
 ! Grid nudging
 /

 &dynamics
 ! hybrid_opt                          = 2,
 ! Dynamical coordinate option
 w_damping                           = 1,
 ! vertical velocity damping on prevents unstable model
 diff_opt                            = 2,    2,    2,	
 ! Turbulence and mixing option
 km_opt                              = 4,    4,    4,	
 ! eddy coefficient option
 damp_opt                            = 3,		
 diff_6th_opt                        = 0,      0,      2,
 diff_6th_factor                     = 0.25,   0.25,   0.12,
 ! Upper level damping (1 for diffusive, 2 and 3 for Rayleigh)
 base_temp                           = 290.,
 ! Base state temperature in K
 zdamp                               = 5000., 5000.,5000.,		
 ! Depth of damping layer in m from model top
 dampcoef                            = 0.2,    0.2,    0.2,
 ! damping coefficient
 khdif                               = 0,    0,    0,	
 ! horizontal diffusion constant
 kvdif                               = 0,    0,    0,	
 ! Vertical diffucion constant
 non_hydrostatic                     = .true., .true., .true.,
 moist_adv_opt                       = 2,      2,      1,
 scalar_adv_opt                      = 2,      2,      1,
 ! 3rd order vertical scalar advection
 gwd_opt                             = 1,
 tke_adv_opt                         = 2, 2, 2,
 tracer_opt                          = 2, 2, 2,
 epssm                               = 0.5,	0.5,	0.5,
 ! time off-centering for vertical sound waves
/

 &fire
 ifire                               = 0, 0, 1,
 fire_num_ignitions                  = 0, 0, 0,
 fire_is_real_perim                  = .false., .false., .true.,
 fire_perimeter_time                 = 0.0, 0.0, 32340, !9*3600 = 32400

 ! Fuel configurations (Set -1 to ensure fuel reads from your real WPS input data)
 fire_fuel_read                      = 0, 0, -1,
 fire_fuel_cat                       = 0, 0, 1,

 ! Diagnostic and Execution selections
 fire_print_msg                      = 0, 0, 1,       ! Enables localized tracking print alerts in rsl logs
 fire_viscosity                      = 0.4,           ! Numerical smoothing variable for level-set boundaries
 fire_atm_feedback                   = 1.0,           ! Enables critical 2-way energy dynamic coupling loop
 fire_grows_only                     = 1,             ! Enforces that your burned pixels cannot un-burn
 fire_tracer_smoke                   = 0.02,          ! Governs mass emission rate fractions for atmospheric transport

 ! Moisture processing profiles
 fire_fmc_read                       = 1, 1, 1,       ! Reads Fuel Moisture Content initially from your namelist constants
 fmoist_run                          = .false., .false., .false.,
 fmoist_interp                       = .false., .false., .false.,
 fmoist_dt                           = 0, 0, 600,
 fmoist_freq                         = 0, 0, 0,
 sfc_full_init                       = .true., .true., .true.,

 ! Strike 2, near Leach Lake
 ! July 22 19:06 MDT = July 23 01:06 UTC
 !fire_ignition_start_lon1 = 0, 0, -117.9066,
 !fire_ignition_start_lat1 = 0, 0, 52.6991,
 !fire_ignition_end_lon1   = 0, 0, -117.9066,
 !fire_ignition_end_lat1   = 0, 0, 52.6991,
 !fire_ignition_radius1    = 0, 0, 200,
 !fire_ignition_start_time1 = 0, 0, 3540,
 !fire_ignition_end_time1  = 0, 0, 3600,

 /

 &bdy_control
 spec_bdy_width                      = 5,		
 ! num boundary rows relaxed toward ERA5. model solution is nudged toward boundary conditions
 specified                           = .true., .false., .false.,	
 ! boundary conditions coming from ERA5 or from parent directory for each domain
 nested                              = .false., .true., .true.,		
 ! Being nested
 /

 &grib2
 /

 &namelist_quilt
 nio_tasks_per_group                 = 0,		
 ! How many dedicated CPU cores handle reading/writing output files. 0 means the compute cores handle I/O
 nio_groups                          = 1,		
 ! num I/O groups
 /