&share
 wrf_core             = 'ARW'
 max_dom              = 3
 start_date           = '2024-06-27_15:00:00', '2024-06-27_15:00:00', '2024-06-27_15:00:00'
 end_date             = '2024-06-28_23:00:00', '2024-06-28_23:00:00', '2024-06-28_23:00:00'
 interval_seconds     = 1800
 io_form_geogrid      = 2
 debug_level          = 0
 subgrid_ratio_x      = 0, 0, 7
 subgrid_ratio_y      = 0, 0, 7
/

&geogrid
 parent_id            = 1, 1, 2
 parent_grid_ratio    = 1, 3, 3
 i_parent_start       = 1, 100, 100
 j_parent_start       = 1, 100, 100
 e_we                 = 300, 301, 301
 e_sn                 = 300, 301, 301
 geog_data_res        = 'default', 'default', 'd03+default'
 dx                   = 1080
 dy                   = 1080
 map_proj             = 'polar'
 ref_lat              = 62.800
 ref_lon              = -137.700
 truelat1             = 62.800
 pole_lat             = 90
 pole_lon             = 0
 stand_lon            = -137.700
 geog_data_path       = '/scratch/su386/pyrocb/out/data/geog'
 opt_geogrid_tbl_path = '/scratch/su386/pyrocb/out/WPS/geogrid/'
/

&ungrib
 out_format           = 'WPS'
 prefix               = '/scratch/su386/pyrocb/out/output/selkirk-2024/met_em/FILE'
/

&metgrid
 fg_name              = '/scratch/su386/pyrocb/out/output/selkirk-2024/met_em/FILE'
 io_form_metgrid      = 2
 opt_metgrid_tbl_path = '/scratch/su386/pyrocb/out/WPS/metgrid/'
/
